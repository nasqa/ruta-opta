{
  "name": "ruta-opta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && stylelint \"apps/**/*.css\"",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "e2e": "npm run e2e --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-check-file": "^3.3.2",
    "lint-staged": "^17.6.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.1.0",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.css": [
      "stylelint --fix"
    ]
  }
}

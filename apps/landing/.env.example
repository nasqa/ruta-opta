# Zoho Campaigns, used by the waitlist form. Set these in Netlify (Site configuration, Environment variables); never commit real values.
# Zoho data center of the account: com, eu, in, com.au, jp, ca, sa or com.cn
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# The list's key, from Zoho Campaigns (Contacts, the list's details)
ZOHO_LIST_KEY=
# Only for local runs and e2e: answer as if Zoho accepted. Ignored on Netlify's production context
# WAITLIST_ADAPTER=fake

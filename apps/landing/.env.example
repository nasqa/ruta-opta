# The waitlist's double opt-in. Production values are set only in Netlify's Production context (Site configuration, Environment variables); never commit real values.
# live sends real email and subscribes in Zoho; anything else answers as if both worked. A production build fails unless it is live
WAITLIST_ADAPTER=fake
# The mailer that sends the confirmation email: cpaas (Zoho CPaaS)
MAIL_PROVIDER=cpaas
# The CPaaS Mail Agent's send token
CPAAS_API_KEY=
# The address the confirmation email comes from, such as newsletter@rutaopta.org
MAIL_FROM_ADDRESS=
# The newsletter tool that keeps the confirmed list: zoho (Zoho Campaigns, the default when unset)
AUDIENCE_PROVIDER=zoho
# Zoho data center of the account: com, eu, in, com.au, jp, sa or com.cn (com when unset)
ZOHO_DC=com
# Client ID of the Zoho Self Client, whose only scope is ZohoCampaigns.contact.UPDATE
ZOHO_CLIENT_ID=
# Client secret of that Self Client
ZOHO_CLIENT_SECRET=
# Refresh token of that Self Client
ZOHO_REFRESH_TOKEN=
# Key of the Spanish list, from Zoho Campaigns (Contacts, the list's details)
ZOHO_LIST_KEY_ES=
# Key of the English list
ZOHO_LIST_KEY_EN=
# 32 random bytes in base64 (openssl rand -base64 32) that seal the confirmation links; fake mode uses a random one when unset
WAITLIST_TOKEN_KEY=
# The previous key while rotating, so links already sent keep working; optional
WAITLIST_TOKEN_KEY_PREVIOUS=
# Most confirmation emails sent per UTC day, a positive integer (1000 when unset)
WAITLIST_DAILY_CAP=

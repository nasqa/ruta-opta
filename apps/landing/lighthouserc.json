{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/es",
        "http://localhost:3000/es/privacidad",
        "http://localhost:3000/es/confirmado",
        "http://localhost:3000/es/confirmar",
        "http://localhost:3000/es/baja",
        "http://localhost:3000/en",
        "http://localhost:3000/en/privacy",
        "http://localhost:3000/en/confirmed",
        "http://localhost:3000/en/confirm",
        "http://localhost:3000/en/unsubscribed"
      ],
      "numberOfRuns": 5
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 199680,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
